# ==========================================
# PYTHON QUIZZ FLASH - CONFIGURACIÓN
# ==========================================
# INSTRUCCIONES:
# 1. Copia este archivo a .env
# 2. Reemplaza los valores con tus claves reales
# 3. NUNCA commites el archivo .env a git
# ==========================================

# ==========================================
# FIREBASE CONFIGURATION
# ==========================================
# Obtén estos valores en: https://console.firebase.google.com/
# Ve a: Tu proyecto → Configuración del proyecto → Tus apps → Flutter

FIREBASE_API_KEY=tu_firebase_api_key_aqui
FIREBASE_AUTH_DOMAIN=python-quizz-flash.firebaseapp.com
FIREBASE_PROJECT_ID=python-quizz-flash
FIREBASE_STORAGE_BUCKET=python-quizz-flash.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=958607684021
FIREBASE_APP_ID=1:958607684021:web:42583ba442df08769069fc
FIREBASE_MEASUREMENT_ID=

# ==========================================
# GOOGLE GEMINI API KEY
# ==========================================
# Para IA de explicaciones y ejercicios de Python
# Obtén tu clave en: https://makersuite.google.com/app/apikey
# Límite gratuito: 60 requests/minuto

GEMINI_API_KEY=tu_gemini_api_key_aqui

# ==========================================
# GROQ API KEY (OPCIONAL - para fallback)
# ==========================================
# Para fallback cuando Gemini falla
# Obtén tu clave en: https://console.groq.com/keys
# Límite gratuito: 30 requests/minuto

GROQ_API_KEY=tu_groq_api_key_aqui

# ==========================================
# NOTAS DE SEGURIDAD IMPORTANTES
# ==========================================
# - Estas claves son SOLO para DESARROLLO
# - En PRODUCCIÓN, usa Firebase Cloud Functions
# - NUNCA compartas estas claves públicamente
# - Rota las claves cada 90 días
# - Si expones una clave, rótala inmediatamente
# ==========================================
